<% layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">

      <h3>listings details</h3>
   </div>
    <div class=" card col-6 offset-3 show-card list-card" >
      
      <img src="<%= listing.image.url%>" class="card-img-top show-img" alt="image">
      <div class="card-body">
        <p class="card-text">
          <b>  <%= listing.title %> </b> <br>
          <%= listing.description %> <br>
          &#x20B9;<%= listing.price.toLocaleString("en-IN") %> <br>
          <%= listing.location %> <br>
          <%= listing.country %>
        </p>
      </div>
    </div>


   
  <div class="btns">
    <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark edit-btn">Edit</a> <!--offset-2  = left se 2 columns khaali
    offset-4  = left se 4 columns khaali-->
    <form method="post"   action="/listings/<%= listing.id %>?_method=DELETE">
      <button class="btn btn-dark ">DELETE</button>  <!-- two column ka space lega or left sa  4 column khali-->
    </form>
  </div>
    
  <!--for review form-->
  <div class="col-8 offset-3">
    <hr>
    <h4>WRITE REVIEW</h4>
    <form method="post" action="/listings/<%= listing.id %>/review" novalidate class="needs-validation">
     <div class="mb-3 mt-3">
      <label for="rating" class="form-label">Rating</label>
      <input type="range" min="1" max="5" id="rating" class="form-range" name="review[rating]"   >
     </div>
     <div class="mb-3 mt-3">
      <label for="comment" class="form-label">comments</label>
      <textarea 
      name="review[comment]"
      id="comment"
      cols="30"
      rows="10"
      class="form-control" required></textarea>
      <div class="invalid-feedback">feedback should be valid!</div>
     </div>
     <button btn btn-outline-dark>submit</button>
    </form>
    <hr/>
    <h4><b>All Reviews</b></h4>
      <div class="row">
      <% for(review of listing.reviews) { %>
       <div class="card col-5  ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title">roman rance</h5>
          <p class="card-text"><%= review.comment %> </p>
         <p class="card-text"> <%= review.rating %>⭐</p>
         <form method="post" class="mb-3"  action="/listings/<%= listing.id %>/review/<%= review._id %>?_method=DELETE">
          <button class=" btn btn-sm btn-dark" >Delete</button>
         </form>
        </div>
       </div>
     

      <% } %>
    
  
    </div>
    
</div>
</div>
</body>
